<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OwnExpeditor.App.Controls"
             x:Class="OwnExpeditor.App.Controls.ValueChange"
             x:Name="Root" x:DataType="c:ValueChange">
  <UserControl.Styles>
    <Style Selector="TextBlock.before"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></Style>
    <Style Selector="TextBlock.after"><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.empty"><Setter Property="FontStyle" Value="Italic" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></Style>
    <Style Selector="Path.arrow"><Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" /></Style>
  </UserControl.Styles>
  <Panel>
    <!-- Horizontal: uma linha, reticências de cada lado -->
    <Grid x:Name="HorizontalView" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding #Root.ShowHorizontal}">
      <TextBlock x:Name="BeforeH" Grid.Column="0" Classes="before trim num" MaxWidth="180" Classes.empty="{Binding #Root.BeforeEmpty}" ToolTip.Tip="{Binding #Root.BeforeText}"
                 Text="{Binding #Root.BeforeText}" HorizontalAlignment="Left" />
      <Path Grid.Column="1" Classes="arrow" Data="{StaticResource IconArrowRight}" Width="18" Height="12" Stretch="Uniform"
            AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="AfterH" Grid.Column="2" Classes="after trim num" MaxWidth="180" Classes.empty="{Binding #Root.AfterEmpty}" Text="{Binding #Root.AfterText}"
                 ToolTip.Tip="{Binding #Root.AfterText}" />
    </Grid>
    <!-- Auto: quebra para a linha de baixo quando não cabe -->
    <WrapPanel x:Name="AutoView" IsVisible="{Binding #Root.ShowAuto}">
      <TextBlock Classes="before num" Classes.empty="{Binding #Root.BeforeEmpty}" Text="{Binding #Root.BeforeText}" Margin="0,0,8,0" TextWrapping="Wrap" MaxWidth="320" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Path Classes="arrow" Data="{StaticResource IconArrowRight}" Width="18" Height="12" Stretch="Uniform" VerticalAlignment="Center"
              AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Classes="after num" Classes.empty="{Binding #Root.AfterEmpty}" Text="{Binding #Root.AfterText}" TextWrapping="Wrap" MaxWidth="320" />
      </StackPanel>
    </WrapPanel>
    <!-- Vertical: antes, seta girada, depois -->
    <StackPanel x:Name="VerticalView" Spacing="2" IsVisible="{Binding #Root.ShowVertical}">
      <TextBlock Classes="before num" Classes.empty="{Binding #Root.BeforeEmpty}" Text="{Binding #Root.BeforeText}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" />
      <Path Classes="arrow" Data="{StaticResource IconArrowRight}" Width="18" Height="12" Stretch="Uniform" HorizontalAlignment="Left"
            RenderTransformOrigin="50%,50%" AutomationProperties.AccessibilityView="Raw">
        <Path.RenderTransform><RotateTransform Angle="90" /></Path.RenderTransform>
      </Path>
      <TextBlock Classes="after num" Classes.empty="{Binding #Root.AfterEmpty}" Text="{Binding #Root.AfterText}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Panel>
</UserControl>
