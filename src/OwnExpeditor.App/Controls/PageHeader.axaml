<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OwnExpeditor.App.Controls"
             x:Class="OwnExpeditor.App.Controls.PageHeader"
             x:Name="Root" x:DataType="c:PageHeader" Height="56">
  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" VerticalAlignment="Center">
    <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="0">
      <TextBlock Classes="caption trim" Text="{Binding #Root.Eyebrow, Converter={x:Static c:Converters.Upper}}"
                 IsVisible="{Binding #Root.Eyebrow, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="title trim" Text="{Binding #Root.TitleUpper}" ToolTip.Tip="{Binding #Root.Title}"
/>
    </StackPanel>
    <TextBlock Grid.Column="1" Classes="metric muted" VerticalAlignment="Center" HorizontalAlignment="Right"
               Text="{Binding #Root.Count}" AutomationProperties.LiveSetting="Polite"
               IsVisible="{Binding #Root.Count, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <ContentControl Grid.Column="2" VerticalAlignment="Center" Content="{Binding #Root.Actions}"
                    IsVisible="{Binding #Root.Actions, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </Grid>
</UserControl>
