<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OwnExpeditor.App.Controls"
             x:Class="OwnExpeditor.App.Controls.CityListItem"
             x:Name="Root" x:DataType="c:CityListItem">
  <UserControl.Styles>
    <Style Selector="ListBoxItem:selected c|CityListItem TextBlock#NameText"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinHeight="44" ToolTip.Tip="{Binding #Root.Title}">
    <StackPanel VerticalAlignment="Center" MinWidth="0" Spacing="1">
      <TextBlock x:Name="NameText" Classes="trim" FontSize="15" FontWeight="SemiBold" Text="{Binding #Root.Title}" />
      <TextBlock Classes="bodysm muted trim" Text="{Binding #Root.Meta}" Opacity="{Binding #Root.IsDimmed, Converter={x:Static c:Converters.DimmedOpacity}}" />
    </StackPanel>
    <c:PendingBadge Grid.Column="1" Variant="Tag" Text="{Binding #Root.PendingText}" VerticalAlignment="Center"
                    IsVisible="{Binding #Root.PendingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </Grid>
</UserControl>
