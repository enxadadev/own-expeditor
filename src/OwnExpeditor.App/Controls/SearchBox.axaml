<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OwnExpeditor.App.Controls"
             xmlns:loc="using:OwnExpeditor.App.Markup"
             x:Class="OwnExpeditor.App.Controls.SearchBox"
             x:Name="Root" x:DataType="c:SearchBox" MinHeight="44">
  <Border Classes="field" Height="44" CornerRadius="{StaticResource RadiusMd}" Padding="12,0,4,0">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
      <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{DynamicResource TextMutedBrush}" Width="16" Height="16"
            Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
      <TextBox x:Name="Input" Grid.Column="1" Classes="bare" Text="{Binding #Root.Text, Mode=TwoWay}"
               Watermark="{Binding #Root.Watermark}" VerticalAlignment="Center" KeyDown="OnKeyDown"
               AutomationProperties.Name="{Binding #Root.Watermark}" />
      <c:Spinner Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding #Root.IsBusy}" />
      <Button Grid.Column="3" Classes="compact icon" Width="40" Height="40" Click="OnClear" Padding="0"
              AutomationProperties.Name="{loc:Tr Search_Clear_A11y}" ToolTip.Tip="{loc:Tr Common_Clear}"
              IsVisible="{Binding #Root.HasText}">
        <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform"
              AutomationProperties.AccessibilityView="Raw" />
      </Button>
    </Grid>
  </Border>
</UserControl>
