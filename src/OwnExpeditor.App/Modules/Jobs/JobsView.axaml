<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OwnExpeditor.App.Modules.Jobs"
             xmlns:c="using:OwnExpeditor.App.Controls"
             xmlns:loc="using:OwnExpeditor.App.Markup"
             x:Class="OwnExpeditor.App.Modules.Jobs.JobsView"
             x:DataType="vm:JobsPageViewModel">
  <UserControl.Styles>
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="ListBox.compactseg ListBoxItem">
      <Setter Property="MinHeight" Value="{StaticResource TargetMin}" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="Rectangle.dashed">
      <Setter Property="Stroke" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="StrokeDashArray" Value="4,3" />
      <Setter Property="RadiusX" Value="{StaticResource RadiusLgValue}" />
      <Setter Property="RadiusY" Value="{StaticResource RadiusLgValue}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Grid RowDefinitions="*,Auto,Auto" IsVisible="{Binding ShowForm}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Tr Jobs_Form_Label}">
        <StackPanel Margin="24,16,24,16" Spacing="12" MaxWidth="960">
          <c:ErrorBanner Severity="Info" Layout="Inline" Title="{Binding NoCatalogTitle}" Message="{loc:Tr Jobs_NoCatalog_Body}"
                         ActionText="{loc:Tr Jobs_NoCatalog_Action}" ActionCommand="{Binding OpenSettingsCommand}" IsVisible="{Binding ShowNoCatalog}" />
          <c:ErrorBanner Severity="Warning" Layout="Inline" Title="{loc:Tr Jobs_Cloud_Title}" Message="{loc:Tr Jobs_Cloud_Body}"
                         DismissCommand="{Binding DismissCloudCommand}" IsVisible="{Binding ShowCloud}" />
          <c:ErrorBanner Severity="Info" Layout="Inline" Title="{loc:Tr Jobs_Editing_Title}" Message="{loc:Tr Jobs_Editing_Body}"
                         ActionText="{loc:Tr Jobs_CancelEdit}" ActionCommand="{Binding CancelEditCommand}" IsVisible="{Binding ShowEditing}" />

          <!-- ① Saída  ⇄  ② Chegada: os mesmos campos -->
          <Grid x:Name="SidesGrid" ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
            <c:SectionCard x:Name="FromCard" Title="{loc:Tr Jobs_Side_From}" VerticalAlignment="Top">
              <c:SectionCard.HeaderActions><c:StepBadge Number="1" IsDone="{Binding FromDone}" /></c:SectionCard.HeaderActions>
              <StackPanel Spacing="8">
                <Panel IsVisible="{Binding ShowCountries}"><vm:JobPickerField x:Name="FromCountryField" DataContext="{Binding FromCountry}" /></Panel>
                <vm:JobPickerField x:Name="FromCityField" DataContext="{Binding FromCity}" />
                <vm:JobPickerField x:Name="FromCompanyField" DataContext="{Binding FromCompany}" />
                <Panel IsVisible="{Binding ShowSlot}"><vm:JobPickerField x:Name="SlotField" DataContext="{Binding Slot}" /></Panel>
              </StackPanel>
            </c:SectionCard>
            <Button x:Name="SwapButton" Grid.Column="1" Classes="icon" Width="44" Height="44" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Command="{Binding SwapCommand}" AutomationProperties.Name="{loc:Tr Jobs_Swap}" ToolTip.Tip="{loc:Tr Jobs_Swap}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path x:Name="SwapIcon" Data="{StaticResource IconSwap}" Fill="{DynamicResource TextMutedBrush}" Width="18" Height="18" Stretch="Uniform"
                      AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="SwapLabel" Classes="body" Text="{loc:Tr Jobs_Swap_Short}" IsVisible="False" VerticalAlignment="Center"
                           AutomationProperties.AccessibilityView="Raw" />
              </StackPanel>
            </Button>
            <c:SectionCard x:Name="ToCard" Grid.Column="2" Title="{loc:Tr Jobs_Side_To}" VerticalAlignment="Top">
              <c:SectionCard.HeaderActions><c:StepBadge Number="2" IsDone="{Binding ToDone}" /></c:SectionCard.HeaderActions>
              <StackPanel Spacing="8">
                <Panel IsVisible="{Binding ShowCountries}"><vm:JobPickerField x:Name="ToCountryField" DataContext="{Binding ToCountry}" /></Panel>
                <vm:JobPickerField x:Name="ToCityField" DataContext="{Binding ToCity}" />
                <vm:JobPickerField x:Name="ToCompanyField" DataContext="{Binding ToCompany}" />
              </StackPanel>
            </c:SectionCard>
          </Grid>

          <!-- sem vaga nem oferta na cidade de saída -->
          <Panel IsVisible="{Binding ShowNoSlots}">
            <Rectangle Classes="dashed" />
            <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="520" Margin="20,16">
              <TextBlock Classes="subtitle" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding NoSlotsTitle}" />
              <TextBlock Classes="body muted" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding NoSlotsBody}" />
            </StackPanel>
          </Panel>

          <!-- mudanças pendentes da cidade de saída -->
          <c:SectionCard Title="{loc:Tr Jobs_Pending_Title}" Padding="14,10" IsVisible="{Binding ShowPendingCard}">
            <ItemsControl ItemsSource="{Binding PendingRows}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PendingJobViewModel">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <StackPanel VerticalAlignment="Center" MinWidth="0">
                      <TextBlock Classes="body trim" FontWeight="SemiBold" Text="{Binding Title}" ToolTip.Tip="{Binding Title}" />
                      <TextBlock Classes="bodysm muted trim" Text="{Binding Detail}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="compact" Content="{loc:Tr Jobs_Pending_Edit}" Command="{Binding EditCommand}"
                            AutomationProperties.Name="{Binding EditAria}" />
                    <Button Grid.Column="2" Classes="compact" Foreground="{DynamicResource DangerBrush}" Content="{loc:Tr Review_Discard}"
                            Command="{Binding DiscardCommand}" AutomationProperties.Name="{Binding DiscardAria}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </c:SectionCard>

          <!-- ③ Carga + detalhes (só com a carga) -->
          <c:SectionCard Title="{loc:Tr Jobs_Step_Cargo}">
            <c:SectionCard.HeaderActions><c:StepBadge Number="3" IsDone="{Binding CargoDone}" /></c:SectionCard.HeaderActions>
            <StackPanel Spacing="12">
              <vm:JobPickerField x:Name="CargoField" DataContext="{Binding Cargo}" />
              <Grid ColumnDefinitions="1.6*,*,1.2*" ColumnSpacing="12" IsVisible="{Binding ShowDetails}">
                <Border Classes="tile">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="caption trim" Text="{loc:Tr Jobs_Field_Expiration, Upper=True}" />
                    <ListBox Classes="segmented compactseg" ItemsSource="{Binding ExpirationChoices}" SelectedItem="{Binding SelectedExpiration, Mode=TwoWay}"
                             AutomationProperties.Name="{loc:Tr Jobs_Field_Expiration}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:JobExpirationChoice"><TextBlock Classes="num" Text="{Binding Label}" /></DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
                <c:StatTile Grid.Column="1" Label="{loc:Tr Jobs_Field_Units}" Value="{Binding UnitsValue}" />
                <c:StatTile Grid.Column="2" Label="{loc:Tr Jobs_Field_Trailer}" Value="{Binding TrailerValue}" />
              </Grid>
            </StackPanel>
          </c:SectionCard>

          <!-- mapa da rota: último bloco da página (outra frente troca o esquema pelo mapa real) -->
          <c:RouteMap Height="{Binding MapHeight}" MinHeight="{Binding MapHeight}" Mode="Schematic" EmptyTitle="{Binding MapEmptyTitle}"
                      EmptyMessage="{Binding MapNote}" Origin="{Binding MapOrigin}" Destination="{Binding MapDestination}"
                      RouteLabel="{Binding MapRouteLabel}" DistanceText="{Binding MapDistanceText}" />
        </StackPanel>
      </ScrollViewer>

      <!-- avisos de limpeza (role=status) e erro ao adicionar: fora da rolagem, sempre à vista -->
      <StackPanel Grid.Row="1" Margin="24,0,24,10" Spacing="8">
      <Border Classes="panel" Padding="12,8" IsVisible="{Binding HasNotice}" AutomationProperties.LiveSetting="Polite">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <Path Data="{StaticResource IconInfo}" Fill="{DynamicResource TextMutedBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top"
                Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw" />
          <TextBlock Grid.Column="1" Classes="bodysm" TextWrapping="Wrap" Text="{Binding Notice}" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="compact icon" Command="{Binding DismissNoticeCommand}" AutomationProperties.Name="{loc:Tr Jobs_Notice_Close}">
            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
          </Button>
        </Grid>
      </Border>
      <c:ErrorBanner Severity="Error" Layout="Inline" Title="{loc:Tr Error_Title_Edit}" Message="{Binding ErrorMessage}"
                     DismissCommand="{Binding DismissErrorCommand}" IsVisible="{Binding HasError}" />
      </StackPanel>

      <!-- barra de ação fixa -->
      <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <TextBlock x:Name="MissingLabel" Classes="bodysm muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding MissingText}" />
          <Button x:Name="AddButton" Grid.Column="1" Classes="accent large" MinWidth="220" Content="{Binding AddText}" Command="{Binding AddCommand}"
                  AutomationProperties.HelpText="{Binding MissingText}" />
        </Grid>
      </Border>
    </Grid>

    <!-- carregando: o índice do save e as distâncias -->
    <c:LoadingPanel Text="{loc:Tr Jobs_Loading}" IsVisible="{Binding IsLoading}" />

    <!-- falha ao montar as opções -->
    <c:ErrorBanner Severity="Error" Layout="Inline" Title="{loc:Tr Jobs_LoadError_Title}" Message="{loc:Tr Jobs_LoadError_Body}"
                   ActionText="{loc:Tr Common_Retry}" ActionCommand="{Binding RetryCommand}" IsVisible="{Binding HasLoadError}"
                   Margin="24" MaxWidth="560" VerticalAlignment="Center" />

    <!-- nenhuma cidade com vaga ou oferta -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="{Binding IsEmptyModule}">
      <c:EmptyState Icon="{StaticResource IconInbox}" Title="{loc:Tr Jobs_Empty_Title}" ActionText="{loc:Tr Action_ChooseSave}" ActionCommand="{Binding ChooseSaveCommand}" />
      <TextBlock Classes="bodysm muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" Text="{loc:Tr Jobs_Empty_Body}" />
      <TextBlock Classes="bodysm muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" Text="{loc:Tr Jobs_Empty_Tip}" />
    </StackPanel>
  </Panel>
</UserControl>
