<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\mascot.ico</ApplicationIcon>
    <!-- App so enxerga Core e Domain; Sii/Data nao vazam por referencia transitiva (ADR 0006). -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <!-- Galeria, amostras de design e seus textos só existem em Debug (ADR 0005, decisão 6). -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="Gallery\**" />
    <Compile Remove="Design\**" />
    <AvaloniaXaml Remove="Gallery\**" />
    <EmbeddedResource Remove="Resources\Gallery*.resx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OwnExpeditor.Core\OwnExpeditor.Core.csproj" />
    <ProjectReference Include="..\OwnExpeditor.Domain\OwnExpeditor.Domain.csproj" />
  </ItemGroup>
</Project>
