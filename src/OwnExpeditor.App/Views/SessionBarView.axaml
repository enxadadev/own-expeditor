<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OwnExpeditor.App.ViewModels"
                          xmlns:loc="using:OwnExpeditor.App.Markup"
             x:Class="OwnExpeditor.App.Views.SessionBarView"
             x:DataType="vm:SessionBarViewModel">
  <Border Height="60" Padding="20,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
          AutomationProperties.Name="{loc:Tr SessionBar_Label}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Classes="bodysm muted" Text="{Binding NoSessionText}" VerticalAlignment="Center" IsVisible="{Binding NoSession}" />

        <Button x:Name="ProfileButton" Classes="chip" Classes.error="{Binding HasError}" IsVisible="{Binding HasSave}"
                Command="{Binding ChangeSaveCommand}" MaxWidth="260"
                ToolTip.Tip="{Binding ChangeHint}" AutomationProperties.Name="{Binding ProfileAutomation}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <StackPanel MinWidth="0">
              <TextBlock Classes="caption" Text="{Binding ProfileLabel}" />
              <TextBlock Classes="body trim" FontWeight="SemiBold" Text="{Binding ProfileName}" />
            </StackPanel>
            <Path Data="{StaticResource IconChevronDown}" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform"
                  VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
          </StackPanel>
        </Button>
        <Button x:Name="SaveButton" Classes="chip" Classes.error="{Binding HasError}" IsVisible="{Binding HasSave}"
                Command="{Binding ChangeSaveCommand}" MaxWidth="260"
                ToolTip.Tip="{Binding ChangeHint}" AutomationProperties.Name="{Binding SaveAutomation}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <StackPanel MinWidth="0">
              <TextBlock Classes="caption" Text="{Binding SaveLabel}" />
              <TextBlock Classes="body trim" FontWeight="SemiBold" Text="{Binding SaveName}" />
            </StackPanel>
            <Path Data="{StaticResource IconChevronDown}" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform"
                  VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
          </StackPanel>
        </Button>
        <Border Classes="kbd" VerticalAlignment="Center" IsVisible="{Binding HasSave}" ToolTip.Tip="{Binding GameName}"
                AutomationProperties.Name="{Binding GameName}">
          <TextBlock Classes="caption" Text="{Binding GameBadge}" Foreground="{DynamicResource TextBrush}" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding ShowReview}"
                    ToolTip.Tip="{Binding GameStatusHint}">
          <Panel Width="10" Height="10" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
            <Ellipse Fill="{DynamicResource DangerBrush}" IsVisible="{Binding IsGameRunning}" />
            <Ellipse Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding !IsGameRunning}" />
          </Panel>
          <TextBlock Classes="bodysm" Text="{Binding GameStatusText}" VerticalAlignment="Center" />
        </StackPanel>
        <Border Classes="kbd" VerticalAlignment="Center" IsVisible="{Binding ShowCloud}" ToolTip.Tip="{Binding CloudAutomation}"
                AutomationProperties.Name="{Binding CloudAutomation}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource IconCloud}" Fill="{DynamicResource AccentTextBrush}" Width="14" Height="14" Stretch="Uniform"
                  VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Classes="caption" Text="{Binding CloudChip}" Foreground="{DynamicResource TextBrush}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Button Grid.Column="1" x:Name="ReviewButton" Classes="accent" Classes.review-none="{Binding !ReviewEnabled}"
              Classes.review-active="{Binding IsReviewActive}" IsVisible="{Binding ShowReview}"
              Command="{Binding ReviewCommand}" IsEnabled="{Binding ReviewEnabled}" Focusable="{Binding ReviewEnabled}"
              ToolTip.Tip="{Binding ReviewHint}" AutomationProperties.Name="{Binding ReviewAutomation}">
        <TextBlock Classes="body num" FontWeight="Bold" Text="{Binding ReviewText}" />
      </Button>
    </Grid>
  </Border>
</UserControl>
