<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OwnExpeditor.App.ViewModels"
             xmlns:v="using:OwnExpeditor.App.Views"
             xmlns:shell="using:OwnExpeditor.App.Shell"
             xmlns:loc="using:OwnExpeditor.App.Markup"
             x:Class="OwnExpeditor.App.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <Panel Background="{DynamicResource BgBrush}">
    <Grid ColumnDefinitions="76,*">
      <!-- navegação lateral -->
      <Border Grid.Column="0" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="0,12,0,12">
          <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
            <Button Classes="nav" Classes.active="{Binding SettingsNav.IsActive}" Command="{Binding SettingsNav.Command}"
                    ToolTip.Tip="{Binding SettingsNav.Title}" AutomationProperties.Name="{Binding SettingsNav.Title}">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <Path Data="{Binding SettingsNav.IconKey, Converter={x:Static shell:ShellConverters.Icon}}"
                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock FontFamily="{StaticResource FontDisplay}" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.2"
                           Text="{Binding SettingsNav.ShortTitle}" HorizontalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="OE" FontFamily="{StaticResource FontDisplay}" FontSize="22" FontWeight="Bold"
                     Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"
                     AutomationProperties.AccessibilityView="Raw" />
          <ItemsControl ItemsSource="{Binding Modules}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding ModulesLabel}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItemViewModel">
                <Button Classes="nav" Classes.active="{Binding IsActive}" IsEnabled="{Binding IsEnabled}" Command="{Binding Command}"
                        ToolTip.Tip="{Binding ToolTip}" AutomationProperties.Name="{Binding Title}">
                  <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <Path Data="{Binding IconKey, Converter={x:Static shell:ShellConverters.Icon}}"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                          Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock FontFamily="{StaticResource FontDisplay}" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.2"
                               Text="{Binding ShortTitle}" HorizontalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
        <v:SessionBarView x:Name="Bar" DataContext="{Binding SessionBar}" />
        <Popup x:Name="PickerPopup" IsOpen="{Binding SessionBar.IsPickerOpen, Mode=TwoWay}" IsLightDismissEnabled="True"
               Placement="BottomEdgeAlignedLeft" PlacementTarget="{Binding #Bar}" HorizontalOffset="20" VerticalOffset="-8">
          <Border Classes="panel" Width="640" Margin="8" BoxShadow="{StaticResource ShadowPopup}">
            <v:SavePickerView DataContext="{Binding SessionBar.Picker}" />
          </Border>
        </Popup>
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        <Border Grid.Row="2" Height="36" Padding="20,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="bodysm muted trim" Text="{Binding SafetyNote}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowReviewHint}">
                <Border Classes="kbd"><TextBlock Classes="caption" Text="Ctrl+R" Foreground="{DynamicResource TextBrush}" /></Border>
                <TextBlock Classes="bodysm muted" Text="{loc:Tr Shell_HintReview}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowApplyHint}">
                <Border Classes="kbd"><TextBlock Classes="caption" Text="Ctrl+Enter" Foreground="{DynamicResource TextBrush}" /></Border>
                <TextBlock Classes="bodysm muted" Text="{loc:Tr Shell_HintApply}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- aviso temporário -->
    <Border Classes="panel" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,56" Padding="16,10"
            IsVisible="{Binding IsVisible}" DataContext="{Binding Toast}" BoxShadow="{StaticResource ShadowPopup}">
      <StackPanel Orientation="Horizontal" Spacing="14" AutomationProperties.LiveSetting="Polite">
        <TextBlock Classes="body" Text="{Binding Text}" VerticalAlignment="Center" MaxWidth="520" TextWrapping="Wrap" />
        <Button Classes="compact" Content="{Binding ActionText}" Command="{Binding RunActionCommand}" IsVisible="{Binding HasAction}" />
        <Button Classes="compact icon" Command="{Binding HideCommand}" AutomationProperties.Name="{loc:Tr Common_Dismiss}">
          <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
        </Button>
      </StackPanel>
    </Border>

    <!-- diálogo modal -->
    <Border Background="{DynamicResource OverlayBrush}" IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Panel>
</UserControl>
