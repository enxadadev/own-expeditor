<!-- Tokens que não mudam com o tema (design/controles/screens.md §1.4–1.5). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:anim="using:Avalonia.Animation.Easings">
  <!-- Fontes: Barlow quando instalada/embutida; Inter (embutida) como reserva. -->
  <FontFamily x:Key="FontUi">Barlow, fonts:Inter#Inter</FontFamily>
  <FontFamily x:Key="FontDisplay">Barlow Condensed, Barlow, fonts:Inter#Inter</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>

  <x:Double x:Key="FontSizeCaption">12</x:Double>
  <x:Double x:Key="FontSizeBodySm">13</x:Double>
  <x:Double x:Key="FontSizeBody">14</x:Double>
  <x:Double x:Key="FontSizeSubtitle">16</x:Double>
  <x:Double x:Key="FontSizeMetric">22</x:Double>
  <x:Double x:Key="FontSizeTitle">26</x:Double>
  <x:Double x:Key="FontSizeHero">34</x:Double>

  <x:Double x:Key="Space1">2</x:Double>
  <x:Double x:Key="Space2">4</x:Double>
  <x:Double x:Key="Space3">8</x:Double>
  <x:Double x:Key="Space4">12</x:Double>
  <x:Double x:Key="Space5">16</x:Double>
  <x:Double x:Key="Space6">20</x:Double>
  <x:Double x:Key="Space7">24</x:Double>
  <x:Double x:Key="Space8">32</x:Double>

  <CornerRadius x:Key="RadiusSm">8</CornerRadius>
  <CornerRadius x:Key="RadiusMd">10</CornerRadius>
  <CornerRadius x:Key="RadiusLg">12</CornerRadius>
  <CornerRadius x:Key="RadiusXl">16</CornerRadius>
  <x:Double x:Key="RadiusLgValue">12</x:Double> <!-- RadiusLg para formas que pedem double (Rectangle.RadiusX) -->
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <x:Double x:Key="TargetMin">40</x:Double>
  <x:Double x:Key="TargetDefault">44</x:Double>
  <x:Double x:Key="TargetPrimary">48</x:Double>

  <sys:TimeSpan x:Key="DurFast">0:0:0.150</sys:TimeSpan>
  <sys:TimeSpan x:Key="DurBase">0:0:0.200</sys:TimeSpan>

  <BoxShadows x:Key="ShadowPopup">0 8 24 0 #40000000, 0 1 2 0 #33000000</BoxShadows>
</ResourceDictionary>
